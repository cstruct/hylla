control {
  // Scripts sign in with HTTP Basic auth. `hylla hash-password` prints the hash of a
  // password it reads from stdin.
  users {
    deploy {password_hash "$argon2id$v=19$m=19456,t=2,p=1$replace-with-the-hash"}
  }
  // For a confidential client; leave it out for a public one, protected by PKCE alone.
  oidc {client_secret replace-with-the-client-secret}
}
backends {
  assets {
    access_key_id AKIA...
    secret_access_key ...
  }
}
