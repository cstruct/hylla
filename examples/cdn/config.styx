// A CDN-style cache in front of a website's assets in S3: a disk cache that survives
// restarts, background refreshes so visitors never wait on S3, stale content while S3 is
// down, and health checks and metrics for running it.
servers {
  site {
    listen 0.0.0.0:8080
    server_names (static.example.com www.example.com)
    mappings (
      {
        path_prefix /assets
        backend site
        // /assets/app.css is the key app.css in the bucket.
        rewrites ({pattern "^/assets/(.*)$", replace /$1})
      }
      // Everything else is under `pages/`: / is pages/index.html.
      {
        path_prefix /
        backend site
        rewrites (
          {pattern "^/$", replace /index.html}
          {pattern "^/(.*)$", replace /pages/$1}
        )
      }
    )
  }
}
backends {
  site {
    type s3
    bucket example-site
    region eu-north-1
    refresh {
      concurrency 8
      rules (
        // Checks every cached asset every 5 minutes, so changes show up without
        // visitors waiting on S3.
        {prefix "", every 5m, mode revalidate}
        // Keeps the front page cached and current, before anyone asks for it.
        {key pages/index.html, every 1m, mode both, max_objects 1}
        // Warms the cache with the CSS and JavaScript, up to 512 MiB.
        {prefix css/, every 1h, mode preload, max_mib 512}
        {prefix js/, every 1h, mode preload, max_mib 512}
      )
    }
  }
}
cache {
  metadata_ttl 5m
  // Past the TTL, serves what's cached while it's checked in the background.
  stale_while_revalidate 1h
  // Keeps serving for a week while S3 fails.
  stale_if_error 7d
  // Writes chunks to disk as they're cached, so a restart keeps them.
  write_policy on_insertion
  memory {capacity_mib 2048}
  disk {
    path /var/cache/hylla
    capacity_mib 102400
  }
}
health {
  listen 0.0.0.0:8081
}
telemetry {
  service_name static-cache
  otlp {endpoint http://otel-collector:4318}
  metrics {enabled true}
  logs {format json}
}
