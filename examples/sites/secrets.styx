// Credentials only come from the secrets file, never from the config or the environment.
backends {
  frontend {
    access_key_id AKIA...
    secret_access_key ...
  }
}
control {
  users {
    // Print a hash with `hylla hash-password`.
    ci {password_hash "$argon2id$v=19$m=19456,t=2,p=1$replace-with-the-hash"}
  }
}
